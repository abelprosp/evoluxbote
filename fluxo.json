    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst chatId = item.chatId || '';\nconst instance = item.instance || '';\nconst text = (item.text || '').trim() || '(sem texto)';\nlet history = [];\ntry {\n  const url = `https://vuavztofxcsgvbovywsw.supabase.co/rest/v1/conversation_history?chat_id=eq.${encodeURIComponent(chatId)}&order=created_at.asc&limit=30`;\n  const res = await this.helpers.httpRequest({\n    method: 'GET',\n    url,\n    headers: {\n      'apikey': process.env.SUPABASE_ANON_KEY || 'REPLACE_WITH_SUPABASE_ANON_KEY',\n      'Authorization': 'Bearer ' + (process.env.SUPABASE_ANON_KEY || 'REPLACE_WITH_SUPABASE_ANON_KEY')\n    },\n    timeout: 10000\n  });\n  history = Array.isArray(res) ? res : [];\n} catch (e) {\n  history = [];\n}\nconst systemContent = 'Voc├¬ ├® a Iza, assistente da EvoluxRH. Ajude candidatos de forma humana. Sobre vagas: diga apenas que h├í vagas em evoluxrh.com.br. N├úo liste vagas. Seja educada e emp├ítica.';\nconst messages = [{ role: 'system', content: systemContent }];\nhistory.forEach(h => { if (h.role && h.content) messages.push({ role: h.role, content: h.content }); });\nmessages.push({ role: 'user', content: text });\nreturn [{ json: { chatId, instance, text: item.text, messages } }];"
      },
